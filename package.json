{
  "name": "agritrade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"python prices_api.py\" \"python arrival_api.py\" \"python location_api.py\" \"python warehouse_api.py\" \"python files/app.py\"",
    "dev": "vite",
    "ml-api": "python files/app.py",
    "train-ml-model": "python files/train_model.py",
    "arrival-api": "python arrival_api.py",
    "location-api": "python location_api.py",
    "warehouse-api": "python warehouse_api.py",
    "mandi-coordinates": "python location_api.py --sync-mandi",
    "mandi-coordinates:apply": "python location_api.py --sync-mandi --apply",
    "warehouse-coordinates": "python location_api.py --sync-warehouses",
    "warehouse-coordinates:apply": "python location_api.py --sync-warehouses --apply",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
